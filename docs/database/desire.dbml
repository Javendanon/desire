  provenance jsonb [not null, check: `((jsonb_typeof(provenance) = 'object'::text) AND (provenance ?& ARRAY['source'::text, 'attribution'::text, 'evidence'::text]) AND (jsonb_typeof((provenance -> 'source'::text)) = 'string'::text) AND (jsonb_typeof((provenance -> 'attribution'::text)) = 'string'::text) AND (jsonb_typeof((provenance -> 'evidence'::text)) = 'string'::text) AND ((provenance ->> 'evidence'::text) = ANY (ARRAY['verified'::text, 'interpretation'::text, 'synthetic'::text])))`, note: 'PostgreSQL domain catalog.provenance']

  Checks {
    `(length(btrim(name)) > 0)`
  }

  Indexes {
    (era_id) [name: 'cities_era']
  }
}

Table catalog.creature_actions {
  id uuid [pk, not null]
  template_id uuid [not null]
  name text [not null]
  kind text [not null]
  description text [not null]

  Checks {
    `(length(btrim(name)) > 0)`
    `(kind = ANY (ARRAY['action'::text, 'bonus_action'::text, 'reaction'::text, 'passive'::text]))`
  }

  Indexes {
    (template_id) [name: 'creature_actions_template']
  }
}

Table catalog.creature_templates {
  id uuid [pk, not null]
  rules_edition text [not null, check: `(rules_edition = ANY (ARRAY['dnd_2014'::text, 'dnd_2024'::text]))`, note: 'PostgreSQL domain catalog.edition']
  revision bigint [not null, check: `((revision >= 1) AND (revision <= '4294967295'::bigint))`, note: 'PostgreSQL domain catalog.revision']
  name text [not null]
  creature_type text [not null]
  size text [not null]
  abilities jsonb [not null]
  armor_class integer [not null]
  max_hp integer [not null]
  speed_m "double precision" [not null, check: `((speed_m > '-Infinity'::double precision) AND (speed_m < 'Infinity'::double precision))`, note: 'PostgreSQL domain catalog.finite_number']
  description text [not null]
  provenance jsonb [not null, check: `((jsonb_typeof(provenance) = 'object'::text) AND (provenance ?& ARRAY['source'::text, 'attribution'::text, 'evidence'::text]) AND (jsonb_typeof((provenance -> 'source'::text)) = 'string'::text) AND (jsonb_typeof((provenance -> 'attribution'::text)) = 'string'::text) AND (jsonb_typeof((provenance -> 'evidence'::text)) = 'string'::text) AND ((provenance ->> 'evidence'::text) = ANY (ARRAY['verified'::text, 'interpretation'::text, 'synthetic'::text])))`, note: 'PostgreSQL domain catalog.provenance']

  Checks {
    `(length(btrim(name)) > 0)`
    `catalog.valid_abilities(abilities)`
    `(armor_class >= 0)`
    `(max_hp >= 0)`
    `((speed_m)::double precision >= (0)::double precision)`
  }

  Indexes {
    (id, rules_edition) [unique]
  }
}

Table catalog.districts {
  id uuid [pk, not null]
  city_id uuid [not null]
  name text [not null]

  Checks {
    `(length(btrim(name)) > 0)`
  }

  Indexes {
    (city_id, id) [unique]
  }
}

Table catalog.eras {
  id uuid [pk, not null]
  world_id uuid [not null]
  name text [not null]

  Checks {
    `(length(btrim(name)) > 0)`
  }

  Indexes {
    (world_id) [name: 'eras_world']
  }
}

Table catalog.knowledge_entries {
  id uuid [pk, not null]
  revision bigint [not null, check: `((revision >= 1) AND (revision <= '4294967295'::bigint))`, note: 'PostgreSQL domain catalog.revision']
  rules_edition text [not null, check: `(rules_edition = ANY (ARRAY['dnd_2014'::text, 'dnd_2024'::text]))`, note: 'PostgreSQL domain catalog.edition']
  language text [not null]
  title text [not null]
  body text [not null]
  provenance jsonb [not null, check: `((jsonb_typeof(provenance) = 'object'::text) AND (provenance ?& ARRAY['source'::text, 'attribution'::text, 'evidence'::text]) AND (jsonb_typeof((provenance -> 'source'::text)) = 'string'::text) AND (jsonb_typeof((provenance -> 'attribution'::text)) = 'string'::text) AND (jsonb_typeof((provenance -> 'evidence'::text)) = 'string'::text) AND ((provenance ->> 'evidence'::text) = ANY (ARRAY['verified'::text, 'interpretation'::text, 'synthetic'::text])))`, note: 'PostgreSQL domain catalog.provenance']

  Checks {
    `(length(btrim(language)) > 0)`
    `(length(btrim(title)) > 0)`
  }

  Indexes {
    (id, rules_edition) [unique]
  }
}

Table catalog.map_versions {
  id uuid [pk, not null]
  map_id uuid [not null]
  city_id uuid
  revision bigint [not null, check: `((revision >= 1) AND (revision <= '4294967295'::bigint))`, note: 'PostgreSQL domain catalog.revision']
  calibration jsonb
  provenance jsonb [not null, check: `((jsonb_typeof(provenance) = 'object'::text) AND (provenance ?& ARRAY['source'::text, 'attribution'::text, 'evidence'::text]) AND (jsonb_typeof((provenance -> 'source'::text)) = 'string'::text) AND (jsonb_typeof((provenance -> 'attribution'::text)) = 'string'::text) AND (jsonb_typeof((provenance -> 'evidence'::text)) = 'string'::text) AND ((provenance ->> 'evidence'::text) = ANY (ARRAY['verified'::text, 'interpretation'::text, 'synthetic'::text])))`, note: 'PostgreSQL domain catalog.provenance']
  calibrated boolean [note: 'GENERATED ALWAYS AS ((calibration IS NOT NULL)) STORED']

  Checks {
    `((calibration IS NULL) OR catalog.valid_calibration(calibration))`
  }

  Indexes {
    (map_id, revision) [unique]
    (city_id, id) [unique]
    (city_id, id, calibrated) [unique]
  }
}

Table catalog.maps {
  id uuid [pk, not null]
}

Table catalog.place_anchors {
  place_id uuid [not null]
  map_version_id uuid [not null]
  city_id uuid [not null]
  x_m "double precision" [not null, check: `((x_m > '-Infinity'::double precision) AND (x_m < 'Infinity'::double precision))`, note: 'PostgreSQL domain catalog.finite_number']
  y_m "double precision" [not null, check: `((y_m > '-Infinity'::double precision) AND (y_m < 'Infinity'::double precision))`, note: 'PostgreSQL domain catalog.finite_number']
  z_m "double precision" [not null, check: `((z_m > '-Infinity'::double precision) AND (z_m < 'Infinity'::double precision))`, note: 'PostgreSQL domain catalog.finite_number']
  provenance jsonb [not null, check: `((jsonb_typeof(provenance) = 'object'::text) AND (provenance ?& ARRAY['source'::text, 'attribution'::text, 'evidence'::text]) AND (jsonb_typeof((provenance -> 'source'::text)) = 'string'::text) AND (jsonb_typeof((provenance -> 'attribution'::text)) = 'string'::text) AND (jsonb_typeof((provenance -> 'evidence'::text)) = 'string'::text) AND ((provenance ->> 'evidence'::text) = ANY (ARRAY['verified'::text, 'interpretation'::text, 'synthetic'::text])))`, note: 'PostgreSQL domain catalog.provenance']
  calibrated boolean [not null, default: `true`]

  Checks {
    `calibrated`
  }

  Indexes {
    (place_id, map_version_id) [pk]
    (city_id, map_version_id) [name: 'anchors_map']
  }
}

Table catalog.places {
  id uuid [pk, not null]
  city_id uuid [not null]
  district_id uuid
  name text [not null]
  provenance jsonb [not null, check: `((jsonb_typeof(provenance) = 'object'::text) AND (provenance ?& ARRAY['source'::text, 'attribution'::text, 'evidence'::text]) AND (jsonb_typeof((provenance -> 'source'::text)) = 'string'::text) AND (jsonb_typeof((provenance -> 'attribution'::text)) = 'string'::text) AND (jsonb_typeof((provenance -> 'evidence'::text)) = 'string'::text) AND ((provenance ->> 'evidence'::text) = ANY (ARRAY['verified'::text, 'interpretation'::text, 'synthetic'::text])))`, note: 'PostgreSQL domain catalog.provenance']

  Checks {
    `(length(btrim(name)) > 0)`
  }

  Indexes {
    (city_id, id) [unique]
    (city_id, district_id) [name: 'places_district']
  }
}

Table catalog.worlds {
  id uuid [pk, not null]
  name text [not null]
  provenance jsonb [not null, check: `((jsonb_typeof(provenance) = 'object'::text) AND (provenance ?& ARRAY['source'::text, 'attribution'::text, 'evidence'::text]) AND (jsonb_typeof((provenance -> 'source'::text)) = 'string'::text) AND (jsonb_typeof((provenance -> 'attribution'::text)) = 'string'::text) AND (jsonb_typeof((provenance -> 'evidence'::text)) = 'string'::text) AND ((provenance ->> 'evidence'::text) = ANY (ARRAY['verified'::text, 'interpretation'::text, 'synthetic'::text])))`, note: 'PostgreSQL domain catalog.provenance']

  Checks {
    `(length(btrim(name)) > 0)`
  }
}

Table private.dm_secrets {
  id uuid [pk, not null]
  campaign_id uuid [not null]
  place_id uuid
  scene_id uuid
  character_id uuid
  session_id uuid
  journal_entry_id uuid
  campaign_knowledge_id uuid
  travel_id uuid
  place_override_id uuid
  condition_id uuid
  body text [not null]
  revision bigint [not null, check: `((revision >= 1) AND (revision <= '4294967295'::bigint))`, note: 'PostgreSQL domain catalog.revision']
  subject_id uuid [note: 'GENERATED ALWAYS AS (COALESCE(place_id, scene_id, character_id, session_id, journal_entry_id, campaign_knowledge_id, travel_id, place_override_id, condition_id)) STORED']
  subject_kind text [note: 'GENERATED ALWAYS AS ( CASE     WHEN (place_id IS NOT NULL) THEN \'place\'::text     WHEN (scene_id IS NOT NULL) THEN \'scene\'::text     WHEN (character_id IS NOT NULL) THEN \'character\'::text     WHEN (session_id IS NOT NULL) THEN \'session\'::text     WHEN (journal_entry_id IS NOT NULL) THEN \'journal_entry\'::text     WHEN (campaign_knowledge_id IS NOT NULL) THEN \'campaign_knowledge\'::text     WHEN (travel_id IS NOT NULL) THEN \'travel\'::text     WHEN (place_override_id IS NOT NULL) THEN \'place_override\'::text     WHEN (condition_id IS NOT NULL) THEN \'condition\'::text     ELSE NULL::text END) STORED']

  Checks {
    `(num_nonnulls(place_id, scene_id, character_id, session_id, journal_entry_id, campaign_knowledge_id, travel_id, place_override_id, condition_id) = 1)`
  }

  Indexes {
    (campaign_id, id) [unique]
    (campaign_id, subject_kind, subject_id) [name: 'secrets_subject']
  }
}

Table public.persistence_migrations {
  version bigint [pk, not null]
  sql text [not null]
  installed_at "timestamp with time zone" [not null, default: `now()`]
}

