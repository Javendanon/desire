{
  "schema_version": 1,
  "description": "Normative, language-neutral search semantics for the local compendium. Every consumer (D09 Rust, D15 TypeScript) must reproduce these results; tools/knowledge/search.py only verifies them and is not the reference implementation.",
  "semantics": {
    "normalization": "Casefold the value, decompose it with NFKD and drop combining marks, so accents and letter case never affect a match.",
    "query": "Normalize the query, split it on whitespace and require every token to appear in the entry.",
    "haystack": "Normalize the entry title, body, slug, kind and reference targets and join them into one searchable text.",
    "filters": "A fixture filter is optional; when present it must equal the entry field of the same name (kind, rules_edition, language, translation_status).",
    "results": "Compare the returned entry ids as a set; ordering is presentation only."
  },
