{
  "version": 1,
  "mode": "enforce",
  "gates": [
    {
      "name": "frontend-check",
      "cmd": "corepack pnpm install --frozen-lockfile && corepack pnpm check && corepack pnpm run test:frontend && corepack pnpm run test:browser && corepack pnpm run verify:waterdeep",
      "timeout_s": 1800,
      "optional": false
    },
    {
      "name": "rust-fmt",
      "cmd": "cargo fmt --all --check",
      "timeout_s": 300,
      "optional": false
    },
    {
      "name": "rust-clippy",
      "cmd": "cargo clippy --workspace --all-targets --locked -- -D warnings",
      "timeout_s": 1200,
      "optional": false
    },
    {
      "name": "rust-test",
      "cmd": "bash crates/persistence/test-postgres.sh",
      "timeout_s": 1200,
      "optional": false
    },
    {
      "name": "wasm-build",
      "cmd": "cargo build -p desire-wasm --target wasm32-unknown-unknown --release --locked",
      "timeout_s": 1200,
      "optional": false
    },
    {
      "name": "quality-gate",
      "cmd": "python3 tools/quality/gate.py --root .",
      "timeout_s": 600,
      "optional": false
    }
  ],
  "never_paths": [
    ".github/**",
    "tools/ci/**",
    "tools/quality/**",
    "merge-policy.json",
    "CODEOWNERS",
    "**/migrations/**",
    "**/auth/**",
    "**/*secret*",
    "**/*.lock",
    "pnpm-lock.yaml",
    "Cargo.toml",
    "package.json",
    ".env*"
  ],
  "doc_extensions": [".md", ".rst", ".txt", ".png", ".svg", ".csv"],
  "max_review_lines": 600,
  "t0_max_lines": 60,
  "t0_max_files": 5,
  "auto_merge": {
    "mode": "enforce",
    "tiers": {
      "T0": {
        "min_score": 70,
        "max_radius_share": 0.0,
        "max_unprotected": 0,
        "max_stale_docs": 0
      },
      "T1": {
        "min_score": 70,
        "max_radius_share": 0.25,
        "max_unprotected": 10,
        "max_stale_docs": 5
      }
    }
  }
}
