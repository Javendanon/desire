    "RulesEdition": {
      "enum": [
        "dnd_2014",
        "dnd_2024"
      ],
      "x-module": "common"
    },
    "Visibility": {
      "enum": [
        "players",
        "dm"
      ],
      "x-module": "common"
    },
    "Evidence": {
      "enum": [
        "verified",
        "interpretation",
        "synthetic"
      ],
      "x-module": "common"
    },
    "MemberRole": {
      "enum": [
        "dm",
        "player"
      ],
      "x-module": "common"
    },
    "TravelStatus": {
      "enum": [
        "planned",
        "moving",
        "completed",
        "cancelled"
      ],
      "x-module": "common"
    },
